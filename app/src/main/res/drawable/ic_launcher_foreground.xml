<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle Antenna / Signal Ray -->
    <path
        android:pathData="M48,27 L42,21 M60,27 L66,21"
        android:strokeWidth="2.5"
        android:strokeColor="#7C4DFF"
        android:strokeLineCap="round" />

    <!-- Stylized Modern OLED TV Outer Frame -->
    <path
        android:pathData="M31,28 C26,28 24,30 24,35 L24,67 C24,72 26,74 31,74 L77,74 C82,74 84,72 84,67 L84,35 C84,30 82,28 77,28 Z"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="24"
                android:startY="28"
                android:endX="84"
                android:endY="74"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#7C4DFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- TV Stand Base -->
    <path
        android:pathData="M47,75 L45,81 L63,81 L61,75"
        android:strokeWidth="2.2"
        android:strokeColor="#7C4DFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Modern "G" + "Play" Emblem Inside Screen -->
    <!-- Curved 'G' outer sweep -->
    <path
        android:pathData="M62,40 C59,37 54,36 49,37 C42,39 37,45 37,52 C37,59 42,65 49,67 C56,68 62,65 65,60 C66.5,57.5 67,54 67,52 L52,52"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="37"
                android:startY="36"
                android:endX="67"
                android:endY="68"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#A78BFA" android:offset="0.5" />
                <item android:color="#7C4DFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Play Triangle Core inside the G -->
    <path
        android:pathData="M47,46 L57,52 L47,58 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="47"
                android:startY="46"
                android:endX="57"
                android:endY="58"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#7C4DFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Tiny Live Pulse Dot at the top right of TV screen -->
    <path
        android:pathData="M78,34 A1.8,1.8 0 1,0 78,34.01"
        android:strokeWidth="3.6"
        android:strokeColor="#FF2A55"
        android:strokeLineCap="round" />

</vector>
